# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# CRM Milestone 18 — .env.example carries no secrets (placeholder values
# only, see the file itself) and exists specifically to be committed so a
# fresh checkout knows which variables a deployment needs. Without this
# negation, the blanket `.env*` rule above silently swallows it too — it
# would never be picked up by `git add .` and would need an explicit
# `git add -f` every time, easy to miss. The ivyhuts-website backend repo's
# own .env.example only stays tracked today because it was committed before
# a same-shaped rule started applying to it; this makes the CRM's exception
# explicit instead of relying on that same accident.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
